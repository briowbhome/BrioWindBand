rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function hasProfile() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function selfProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwner() {
      return hasProfile() && selfProfile().role == 'owner';
    }

    // 8/23 新增：hasProfile() 只檢查「users/{uid} 文件存在」，不檢查 status——pending/
    // suspended/removed 依設計都會保留文件，單靠 hasProfile() 會讓這些本該被擋住的帳號
    // 還是能通過檢查。簽到／出缺席回報這幾個「操作性」規則要用這個而不是 hasProfile()，
    // 才能真正把已停權/退團/尚未審核的帳號擋在外面
    function isApprovedMember() {
      return hasProfile() && selfProfile().status == 'approved';
    }

    // 9/19 分部管理分團：concerts/*/pieces／sections／notes 巢狀在 concerts/{concertId} 底下，
    // team 存在音樂會本身，不在這些子文件上，用 get() 跨文件讀取（既有模式，checkinSessions／
    // eventRosters 都這樣用）
    function concertTeamOf(concertId) {
      return get(/databases/$(database)/documents/concerts/$(concertId)).data.team[0];
    }

    // 9/19 審核與活動週邊資料分團：checkinSessions／checkins／eventRosters／attendanceReports
    // 都用 eventId 綁定，team 存在活動本身，用 get() 跨文件讀取（跟 concertTeamOf 同一種手法）
    function eventTeamOf(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.team[0];
    }

    // ---------- 依團別的角色/權限判斷（9/16 校友團/校內團分割新增）----------
    // 9/20 收尾：原本並存的全域版本 isAdminTier()/canManageRoles() 已經清掉，僅存的三個
    // 呼叫點（settings/instruments、announcements category=update、feedbackItems）都已經
    // 改成呼叫下面這批依團別版本的「任一團符合就算」寫法
    function teamProfile(team) {
      return selfProfile().teams != null ? selfProfile().teams.get(team, null) : null;
    }

    function hasTeam(team) {
      return hasProfile() && teamProfile(team) != null;
    }

    function isAdminTierFor(team) {
      return isOwner() || (hasTeam(team) && teamProfile(team).role == 'admin');
    }

    function isConductorFor(team) {
      return hasTeam(team) && teamProfile(team).role == 'conductor';
    }

    function canManageRolesFor(team) {
      return isOwner() ||
        (hasTeam(team) &&
          teamProfile(team).permissions != null &&
          teamProfile(team).permissions.canManageRoles == true);
    }

    function canManageFinanceFor(team) {
      return isOwner() ||
        (hasTeam(team) &&
          teamProfile(team).permissions != null &&
          teamProfile(team).permissions.canManageFinance == true);
    }

    function canManageSheetMusicFor(team) {
      return isOwner() ||
        (hasTeam(team) &&
          teamProfile(team).permissions != null &&
          teamProfile(team).permissions.canManageSheetMusic == true);
    }

    function canManageEventTypesFor(team) {
      return isOwner() ||
        (hasTeam(team) &&
          teamProfile(team).permissions != null &&
          teamProfile(team).permissions.canManageEventTypes == true);
    }

    function canManageSectionFor(team, instrumentName) {
      return isOwner() ||
        (hasTeam(team) &&
          teamProfile(team).sectionLeaderFor != null &&
          instrumentName in teamProfile(team).sectionLeaderFor);
    }

    // 9/19 資安修正：team 分割後 teams.{team}.role/permissions 才是實際的權限判斷依據，
    // 這個函式原本只擋全域 role/permissions 兩個頂層欄位，沒擋到 teams/teamIds，導致任何
    // 「該團 admin」都能繞過 canManageRolesFor 的授權，透過下面「一般審核操作」規則
    // 直接幫自己或同團的人把 teams.{team}.permissions 改成 true。這裡把 teams/teamIds
    // 也一併擋掉——這兩個欄位只能透過下面專門的 canManageRolesFor 規則調整
    function touchesRoleOrPermissions() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'teams', 'teamIds']);
    }

    // 簽到碼是否仍然有效：checkinSessions/{eventId} 存在、code 相符、還沒過期
    function sessionValid(eventId, code) {
      return exists(/databases/$(database)/documents/checkinSessions/$(eventId)) &&
        get(/databases/$(database)/documents/checkinSessions/$(eventId)).data.code == code &&
        get(/databases/$(database)/documents/checkinSessions/$(eventId)).data.windowEnd > request.time;
    }

    match /users/{uid} {
      // 本人可以讀自己的資料（登入後檢查審核狀態用）
      allow get: if request.auth != null && request.auth.uid == uid;

      // 一般審核操作：Admin/Owner 對「一般團員」核准／拒絕／標記停用／軟刪除，改成看
      // 申請人所屬團別的 admin（teamIds 在申請當下一定剛好一個值，見下方團別版 create 規則）
      // 不能透過這條規則動到 role 或 permissions 欄位。9/20 收尾：頂層 role 即將被清除腳本
      // 刪掉（Owner 除外），「是不是一般團員」改看申請人那一團的 teams.{team}.role，用
      // .get(key, default) 安全存取（跟上面 teamProfile() 同一種防呆寫法），避免極端情況下
      // （teamIds 是空陣列、或 teams 底下缺對應的鍵）整條規則直接算不出結果
      allow update: if isAdminTierFor(resource.data.teamIds[0])
        && resource.data.teams.get(resource.data.teamIds[0], {}).get('role', null) == 'member'
        && !touchesRoleOrPermissions();

      // 9/19 收尾計畫：原本的全域角色/權限編輯功能已經拿掉，這條規則的角色改成只放行
      // instruments 欄位——角色/權限/分部長都已經有各自的團別版規則負責，這裡唯一要補的
      // 缺口是讓幹部能改動「全域角色不是 member」的既有帳號（既有指揮/管理員）的樂器/聲部
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['instruments'])
        && (isOwner()
          || (resource.data.teamIds.hasAny(['alumni']) && isAdminTierFor('alumni'))
          || (resource.data.teamIds.hasAny(['school']) && isAdminTierFor('school')));

      // Owner 編輯自己的安全欄位：上面兩條規則都把 Owner 自己的文件排除在外（刻意設計，
      // 防止 role/permissions 被任何管道改動，即使是 Owner 本人），但這樣 Owner 連自己的
      // 樂器/聲部、分部長都沒地方能改。這裡只放行這兩個欄位，role/permissions/status/account
      // 等敏感欄位仍然完全鎖死，不因為是本人操作就放寬
      allow update: if isOwner()
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['role', 'permissions', 'status', 'account', 'accountLower', 'approvedAt', 'approvedBy', 'createdAt', 'expiresAt']
        );

      // 通知訂閱：本人可以自行開關推播通知、寫入/清除訂閱物件，不需要幹部層級權限，
      // 只放行這四個欄位，role/permissions/status 等敏感欄位仍然完全鎖死。
      // isAdminTier() 本來就能 get/list 整個 users collection（審核/名冊用途），代表幹部
      // 技術上讀得到別人的 pushSubscription，但缺少對應的 VAPID 私鑰就無法用這個 subscription
      // 送出任何東西，已跟使用者確認這個取捨可以接受
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['notificationsEnabled', 'pushSubscription', 'notificationsUpdatedAt', 'notificationsReadAt']
        );

      // 個人資料自我編輯：任何登入者都能改自己的姓名/生日/電話/車牌，不需要幹部層級權限。
      // 刻意不放行 instruments/sectionLeaderFor——樂器/聲部牽動座位圖、簽到分區、分部長指派
      // 等多處邏輯，維持由幹部在 roles-admin.html 調整，不開放團員自行更改；account/role/
      // permissions/status 等敏感欄位一樣完全鎖死。這條跟上面 Owner 專屬的自編輯規則是分開
      // 獨立的規則，兩條並存不衝突（Owner 改 instruments/sectionLeaderFor 走上面那條，
      // 改姓名/生日/電話/車牌走這條）
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['name', 'birthday', 'phone', 'licensePlate']
        );

      // 硬刪除：只開放給「已拒絕」的申請（對應已拒絕清單的「立即移除」）
      // 現役帳號一律走軟刪除（status: removed），真正的硬刪除由 Owner 在 Console 手動處理，不走這裡
      // 9/19 分團：改看申請人所屬團別的 admin
      allow delete: if isAdminTierFor(resource.data.teamIds[0]) && resource.data.status == 'rejected';

      // ---------- 依團別的規則（9/16 新增，見上方 teamProfile 等 helper 說明）----------

      // 幹部/指揮依團別讀取／列出所有團員資料。9/19 收尾計畫：拿掉了原本並存的全域
      // isAdminTier()/isConductor() fallback——查證過現有 7 個既有幹部/指揮/Owner 帳號
      // 的團別版角色都跟全域值一致，這條規則已經完整涵蓋
      //
      // 9/22 收緊：原本「任一團 admin/指揮都能讀取全部 users」的範圍比對應的寫入規則
      // （看「目標所屬團」）寬——任一團的幹部技術上能讀到完全不相干的另一團申請人/團員
      // 原始資料（動不了，只是讀得到）。使用者確認後收緊成跟寫入規則同一個原則：只放行
      // 「目標所屬的那個團」自己有 admin/conductor 身分的人。雙團籍目標（teamIds 不只
      // 一個值）只要其中一團符合就放行，寫法比照上面 128-131 行既有的「依 teamIds 逐一
      // 比對」模式——不能直接比照 121 行用 teamIds[0]，那個寫法的安全前提是「這個時候
      // teamIds 保證只有一個值」（見該行註解），這裡不成立。收緊前先做過一輪全站排查，
      // 確認所有查 users collection 的地方都已經依 teamIds 篩選成請求者自己管得到的範圍，
      // 不會有查詢因為這條規則收緊而被整批拒絕，細節見 schema.md「9/22」章節
      allow get, list: if
        (resource.data.teamIds.hasAny(['alumni']) && (isAdminTierFor('alumni') || isConductorFor('alumni'))) ||
        (resource.data.teamIds.hasAny(['school']) && (isAdminTierFor('school') || isConductorFor('school')));

      // 註冊：只能建立「自己」的文件，狀態一定要 pending，且 teamIds 剛好一個值、teams
      // 底下只能有這一個團的鍵、那個團的內容只能有 role 且必須是 member——不能連帶塞入
      // permissions/sectionLeaderFor/positionPresets，頂層也不能帶 role 或 permissions
      // 欄位（防止自己把自己設成 owner；9/20 收尾：Owner 以外不再有頂層 role，新註冊帳號
      // 直接比照 permissions 的做法整個禁止出現，不再要求「等於 member」）。9/19 資安修正：
      // 原本跟這條並存的舊規則（只檢查全域 role/status，見上方已刪除的版本）完全沒做
      // 這些形狀檢查，且這條原本也沒擋 permissions/teams 內容，會讓自建 Firestore 文件的人
      // 在註冊當下就直接自我授予幹部權限，完全不需要任何審核就能生效
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && !('role' in request.resource.data)
        && !('permissions' in request.resource.data)
        && request.resource.data.teamIds is list
        && request.resource.data.teamIds.size() == 1
        && request.resource.data.teamIds[0] in ['alumni', 'school']
        && request.resource.data.teams.keys().hasOnly([request.resource.data.teamIds[0]])
        && request.resource.data.teams[request.resource.data.teamIds[0]].keys().hasOnly(['role'])
        && request.resource.data.teams[request.resource.data.teamIds[0]].role == 'member';

      // 角色與權限調整（團別版）：只持有「該團」canManageRoles 的人（或 Owner），
      // 一次只能改動 teams 裡的其中一團，不能同時動兩團，也不能連帶動到任何其他欄位
      // （包含全域的 role/status/permissions）。resource.data.get('teams', {}) 是既有文件
      // 可能還沒有 teams 欄位（尚未遷移）時的安全預設值
      // 9/17 修正：原本寫死只能動 'teams' 這一個欄位，但「加入這團」需要同時補上
      // teamIds（規格文件的設計就是 teamIds 要跟 teams 的鍵值同步，見 9/16 設計文件），
      // 放寬成 teams/teamIds 兩個欄位都可以動（單獨動 teams、或兩個一起動都允許）
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teams', 'teamIds'])
        && request.resource.data.teams.diff(resource.data.get('teams', {})).affectedKeys().hasOnly(['alumni'])
        && canManageRolesFor('alumni');

      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teams', 'teamIds'])
        && request.resource.data.teams.diff(resource.data.get('teams', {})).affectedKeys().hasOnly(['school'])
        && canManageRolesFor('school');
    }

    // 活動（通用，音樂會/團練都在這裡）
    // 8/22 起改成完全公開讀取——首頁改成訪客（未登入）也看得到活動列表/下次團練，
    // 是刻意的決定：任何拿得到網址的人都能讀到活動名稱/時間/地點，不再需要帳號
    match /events/{eventId} {
      allow get, list: if true;

      // 9/17 分團：建立時看「即將寫入的活動屬於哪團」，改/刪時看「這筆活動現在屬於哪團」，
      // team[0] 是因為目前 UI 只會單選、陣列裡一定只有一個值——如果之後真的開放聯合活動
      // 多選，這裡的權限判斷邏輯需要重新設計（例如要求對陣列內每個團都有權限），
      // 不是這次的範圍。讀取（get/list）維持完全公開不動，理由見規格文件「D」一節
      allow create: if isAdminTierFor(request.resource.data.team[0]);
      allow update, delete: if isAdminTierFor(resource.data.team[0]);
    }

    // 活動類型清單（給活動的 type 欄位用，決定顯示名稱/顏色，首頁也靠 homeHighlight
    // 判斷哪一場算「下次團練」）。同上，改成公開讀取讓訪客也能正確算出下次團練卡片
    match /eventTypes/{typeId} {
      allow get, list: if true;
      allow create, update, delete: if canManageEventTypesFor('alumni') || canManageEventTypesFor('school');
    }

    // 公告，首頁顯示用。發布者（createdBy）只記錄留存，不對團員顯示。
    // 同上改成公開讀取，訪客首頁也看得到公告內容
    // 9/19 分團：寫入權限改成團別版（isAdminTierFor(team)），讀取（get/list）完全不變。
    // 9/19 追加修正：「更新」分類公告記錄的是 App 軟體版本異動，跟團別無關，寫入權限
    // 維持全域層級（9/20 收尾：原本的 isAdminTier() 改成「任一團 admin」，不再靠頂層 role）
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create: if request.resource.data.category == 'update'
        ? (isAdminTierFor('alumni') || isAdminTierFor('school'))
        : isAdminTierFor(request.resource.data.team);
      allow update, delete: if resource.data.category == 'update'
        ? (isAdminTierFor('alumni') || isAdminTierFor('school'))
        : isAdminTierFor(resource.data.team);
    }

    // 樂器/聲部清單，註冊頁（未登入）也要能讀，所以開放公開讀取；調整交給任一團有
    // canManageRoles 的人（9/20 收尾：原本的全域 canManageRoles() 改成團別版）
    match /settings/instruments {
      allow get: if true;
      allow write: if canManageRolesFor('alumni') || canManageRolesFor('school');
    }

    // 座位圖分區清單（哪個扇形分區對應哪個樂器），conductor-admin.html 讀取用，
    // 所有登入的人都能讀（資料本身不敏感，跟 eventTypes/instruments 一樣）。
    // 寫入刻意收緊成只有 Owner——8/19 使用者要求「暫時不希望其他人能編輯座位圖」，
    // 跟 instruments/eventTypes 慣用的 canManageRolesFor/canManageEventTypesFor 不同層級，
    // 之後如果要放寬給其他幹部編輯，把這裡換回 canManageRolesFor('alumni') || canManageRolesFor('school') 就好
    match /settings/seatingSections {
      allow get: if hasProfile();
      allow write: if isOwner();
    }

    // 9/18 分團：拆成兩份文件，查詢邏輯不變，只是文件路徑依團別決定。權限判斷式
    // 完全不變——編輯維持全域 Owner-only，這是 2026-09-18 使用者明確確認過的決定，
    // 不比照其他子專案改成 canManageRolesFor(team)
    match /settings/seatingSections_alumni {
      allow get: if hasProfile();
      allow write: if isOwner();
    }

    match /settings/seatingSections_school {
      allow get: if hasProfile();
      allow write: if isOwner();
    }

    // 財務分類清單／期初餘額，跟 feeDues/feePayments/ledgerEntries 同一個權限門檻，
    // 不對一般團員開放讀取
    match /settings/financeCategories {
      allow get: if isAdminTierFor('alumni') || isAdminTierFor('school')
        || canManageFinanceFor('alumni') || canManageFinanceFor('school');
      allow write: if isAdminTierFor('alumni') || isAdminTierFor('school')
        || canManageFinanceFor('alumni') || canManageFinanceFor('school');
    }

    // 9/18 分團：拆成兩份文件，查詢邏輯不變，只是文件路徑依團別決定。讀取維持全體
    // 登入者可讀（理由同上，銀行/帳號不是機密），寫入依團別檢查
    match /settings/financeRemittanceAccounts_alumni {
      allow get: if hasProfile();
      allow write: if isAdminTierFor('alumni') || canManageFinanceFor('alumni');
    }

    match /settings/financeRemittanceAccounts_school {
      allow get: if hasProfile();
      allow write: if isAdminTierFor('school') || canManageFinanceFor('school');
    }

    match /settings/financeSettings_alumni {
      allow get, write: if isAdminTierFor('alumni') || canManageFinanceFor('alumni');
    }

    match /settings/financeSettings_school {
      allow get, write: if isAdminTierFor('school') || canManageFinanceFor('school');
    }

    // 簽到中狀態，一場活動最多一份，過期後由 TTL 或幹部手動清除
    match /checkinSessions/{eventId} {
      // 團員掃碼時要讀這份資料驗證 code／期限。8/23 從 hasProfile() 收緊成
      // isApprovedMember()——否則 pending/suspended/removed 的帳號也能直接讀到有效簽到碼
      allow get: if isApprovedMember();
      // 幹部後台「生效中清單」用——9/19 分團：任一團的 admin 都能讀（跟現況曝露程度一致）
      allow list: if isAdminTierFor('alumni') || isAdminTierFor('school');
      allow create, update, delete: if isAdminTierFor(eventTeamOf(eventId));
    }

    // 簽到紀錄，永久保留
    match /checkins/{checkinId} {
      // 本人可以查自己是否已簽到過（用文件 ID 判斷，不依賴文件是否存在）
      allow get: if request.auth != null &&
        (checkinId.split('_')[1] == request.auth.uid || isAdminTierFor('alumni') || isAdminTierFor('school'));
      allow list: if isAdminTierFor('alumni') || isAdminTierFor('school');
      // 指揮專用頁面唯讀查看統計，不開放建立/修改/刪除
      allow get, list: if isConductorFor('alumni') || isConductorFor('school');

      // 團員掃碼簽到：只能建立「自己」的紀錄，文件 ID 必須對應 eventId_uid，
      // 且對應的簽到中狀態必須存在、code 相符、還在有效期限內。8/23 加上 isApprovedMember()
      // ——原本沒檢查 status，被停權/退團的帳號只要還留著登入態，一樣能幫自己寫入簽到紀錄
      allow create: if request.auth != null
        && isApprovedMember()
        && checkinId == request.resource.data.eventId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.method == 'qr'
        && sessionValid(request.resource.data.eventId, request.resource.data.code);

      // 幹部手動補登／修正／刪除（event-admin.html 活動明細 sheet 的「簽到」分頁）
      allow create, update, delete: if isAdminTierFor(eventTeamOf(checkinId.split('_')[0]));
    }

    // 可重複使用的參與名單範本（名單管理，roster-admin.html）：文件 ID 自動產生，
    // members 套用到 eventRosters 時是複製快照，不是即時參照。9/19 資安修正：get/list
    // 原本沒有依團別過濾（任一團的 admin 都能讀到另一團的範本名稱/人數），跟自己的
    // create/update/delete 不一致，也跟 event-admin.html「套用範本」下拉選單會直接
    // 顯示出來的資訊不對稱，這裡改成跟寫入規則一致的團別版
    match /rosterTemplates/{templateId} {
      allow get, list: if isAdminTierFor(resource.data.team);
      allow create: if isAdminTierFor(request.resource.data.team);
      allow update, delete: if isAdminTierFor(resource.data.team);
    }

    // 出缺席調查：幹部建立的參與名單（應到名單），文件 ID = eventId
    match /eventRosters/{eventId} {
      // 幹部後台可讀取全部——9/19 分團：任一團的 admin 都能讀
      allow get, list: if isAdminTierFor('alumni') || isAdminTierFor('school');
      // 團員查詢自己在哪些活動的名單內（首頁回報用），搭配 array-contains 查詢，
      // 只有回傳結果本來就包含自己 uid 的文件才會通過這條規則
      allow list: if hasProfile() && resource.data.members.hasAny([request.auth.uid]);
      allow create, update, delete: if isAdminTierFor(eventTeamOf(eventId));
      // 指揮專用頁面唯讀查看應到名單，不開放建立/修改/刪除
      allow get, list: if isConductorFor('alumni') || isConductorFor('school');
    }

    // 出缺席調查：團員自主回報，文件 ID = eventId_uid（跟 checkins 同樣的去重方式）
    match /attendanceReports/{reportId} {
      // 幹部後台可讀取全部——9/19 分團：任一團的 admin 都能讀
      allow get, list: if isAdminTierFor('alumni') || isAdminTierFor('school');
      // 本人查詢/讀取自己的回報狀態
      allow list: if hasProfile() && resource.data.uid == request.auth.uid;
      allow get: if request.auth != null && reportId.split('_')[1] == request.auth.uid;

      // 團員回報：文件 ID 必須對應 eventId_uid，且必須在該活動的參與名單內才能回報。
      // 8/23 加上 isApprovedMember()——原本沒檢查 status，被停權/退團的帳號如果還留在
      // 某場活動的應到名單裡（名單是快照，事後被移除狀態不會回頭清掉名單），一樣能寫入回報
      allow create, update: if isApprovedMember()
        && reportId == request.resource.data.eventId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/eventRosters/$(request.resource.data.eventId))
        && get(/databases/$(database)/documents/eventRosters/$(request.resource.data.eventId)).data.members.hasAny([request.auth.uid]);

      // 幹部手動修正／刪除
      allow create, update, delete: if isAdminTierFor(eventTeamOf(reportId.split('_')[0]));
      // 指揮專用頁面唯讀查看回報狀況，不開放建立/修改/刪除
      allow get, list: if isConductorFor('alumni') || isConductorFor('school');
    }

    // 指揮頁面的私人筆記本——8/19 又一輪從「綁活動、文件 ID = eventId_uid」改成「不綁活動，
    // 可以新增多則、永久保留」，因為原本設計換一場活動舊筆記就看不到了，使用者覺得不合理。
    // 文件 ID 改用 Firestore 自動產生（沒有天然的去重鍵可以組，是刻意跟其他 collection
    // 手動組 ID 慣例不同的例外），改用文件裡的 uid 欄位判斷歸屬，不再靠切字串解析 ID。
    // 「本人」不限定 conductor 角色——conductor-admin.html 是 admin/owner/conductor 都能
    // 進的頁面，筆記本身是「誰用這頁誰就有自己的筆記」。「私人」是字面意思：只有本人可以
    // 讀寫，Owner 額外開放讀取方便測試/必要時查看，其他人看不到別人的筆記
    // 9/19 分團：create 改成團別版（isConductorFor(team)/isAdminTierFor(team)），
    // get/list/update/delete 完全不變——本來就只看 uid 是否對上本人，跟團別無關
    match /conductorNotes/{noteId} {
      allow get: if request.auth != null &&
        (resource.data.uid == request.auth.uid || isOwner());
      allow list: if hasProfile() && resource.data.uid == request.auth.uid;

      allow create: if request.auth != null
        && (isConductorFor(request.resource.data.team) || isAdminTierFor(request.resource.data.team))
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 曲目資料庫（全團共用，跨音樂會重複使用，repertoire-admin.html 管理）：讀取開放給
    // 所有登入者（含審核中），跟 settings/seatingSections 同一層級的非敏感共用清單一樣；
    // 寫入這輪範圍內收在 isAdminTier()
    match /repertoire/{pieceId} {
      allow get, list: if hasProfile();
      allow create, update, delete: if isAdminTierFor('alumni') || isAdminTierFor('school')
        || canManageSheetMusicFor('alumni') || canManageSheetMusicFor('school');
    }

    // 財務記帳（finance-admin.html）：應繳項目批次、繳費紀錄、記帳本收支明細。
    // 刻意讀寫都鎖在 isAdminTierFor(team)/canManageFinanceFor(team)，不像 events/announcements/
    // repertoire 那樣對一般團員（甚至訪客）開放讀取——財務資料敏感度不同，一般團員
    // 完全看不到任何財務頁面或資料（feeDues/feePayments 各自的自查規則除外）。
    // 9/18 分團：team 是單一字串（不是陣列，跟 events.team 不同——財務已確認兩團完全
    // 獨立結算），判斷式直接傳字串進 isAdminTierFor/canManageFinanceFor，不用取 [0]
    match /feeDues/{dueId} {
      allow get, list: if isAdminTierFor(resource.data.team) || canManageFinanceFor(resource.data.team);
      // 團員自查：只放行「自己在 memberIds 名單內」的項目，跟 eventRosters 對
      // members 用 hasAny() 判斷同一套寫法，首頁通知中心/團務總覽用這條查自己的應繳項目
      allow list: if hasProfile() && resource.data.memberIds.hasAny([request.auth.uid]);
      allow create: if isAdminTierFor(request.resource.data.team) || canManageFinanceFor(request.resource.data.team);
      allow update, delete: if isAdminTierFor(resource.data.team) || canManageFinanceFor(resource.data.team);
    }

    match /feePayments/{paymentId} {
      allow get, list: if isAdminTierFor(resource.data.team) || canManageFinanceFor(resource.data.team);
      // 團員自查自己的繳費紀錄，跟 attendanceReports 對本人開放 list/get 同一套寫法
      allow list: if hasProfile() && resource.data.uid == request.auth.uid;
      allow get: if request.auth != null && paymentId.split('_')[1] == request.auth.uid;
      allow create: if isAdminTierFor(request.resource.data.team) || canManageFinanceFor(request.resource.data.team);
      allow update, delete: if isAdminTierFor(resource.data.team) || canManageFinanceFor(resource.data.team);
    }

    match /ledgerEntries/{entryId} {
      allow get, list: if isAdminTierFor(resource.data.team) || canManageFinanceFor(resource.data.team);
      allow create: if isAdminTierFor(request.resource.data.team) || canManageFinanceFor(request.resource.data.team);
      allow update, delete: if isAdminTierFor(resource.data.team) || canManageFinanceFor(resource.data.team);
    }

    // 音樂會（event-admin.html「音樂會」區塊管理）。讀取開放給所有登入者，讓團員能在
    // 首頁「團務總覽／我的音樂會」查到自己參與的音樂會內容
    match /concerts/{concertId} {
      allow get, list: if hasProfile();
      allow create: if isAdminTierFor(request.resource.data.team[0]);
      allow update, delete: if isAdminTierFor(resource.data.team[0]);

      // 音樂會引用曲目資料庫裡的曲子（文件 ID 沿用 repertoire 的 pieceId），這裡只存
      // order/addedAt，曲名/分部結構一律讀 repertoire/{pieceId}
      match /pieces/{pieceId} {
        allow get, list: if hasProfile();
        allow create, update, delete: if isAdminTierFor(concertTeamOf(concertId));

        // 每曲 × 每樂器分部指派，文件 ID = 樂器名稱。分部長（一般團員身分）能寫入自己
        // sectionLeaderFor 範圍內的文件（canManageSectionFor()），不檢查 parts[].members
        // 內容的正確性——名單/樂器資格由 section-admin.html 前端的可選名單篩選把關，
        // 規則只負責「誰能碰這份文件」
        match /sections/{instrumentName} {
          allow get, list: if hasProfile();
          allow create, update, delete: if isAdminTierFor(concertTeamOf(concertId)) || canManageSectionFor(concertTeamOf(concertId), instrumentName);
        }
      }

      // 分部筆記：綁在「音樂會」這層（不是巢狀在 pieces 底下），pieceId 是筆記上的一個
      // 欄位、不是路徑層級，可留空代表不限定曲目的通用提醒——這是使用者在設計討論時
      // 明確要求的（一次團練可能同時練好幾首曲子，巢狀在曲目底下要多一層點擊）。讀取
      // 比照 concerts/pieces/sections/concertRosters 既有的「所有登入者可讀」慣例。
      // 新增只檢查 authorUid 是自己，不深驗證 instrumentName 是否真的對應這場音樂會的
      // 樂器身分——跟 canManageSectionFor() 對 sections 內容不做正確性檢查同一種取捨，規則
      // 只負責「誰能碰這份文件」，可選樂器範圍由前端讀 concertRosters 把關
      match /notes/{noteId} {
        allow get, list: if hasProfile();
        allow create: if hasProfile() && request.resource.data.authorUid == request.auth.uid;
        allow update: if hasProfile() && resource.data.authorUid == request.auth.uid;
        allow delete: if isAdminTierFor(concertTeamOf(concertId))
          || (hasProfile() && resource.data.authorUid == request.auth.uid)
          || canManageSectionFor(concertTeamOf(concertId), resource.data.instrumentName);
      }
    }

    // 音樂會參與名單，跟 eventRosters 同樣的文件 ID 慣例（= concertId）。讀取開放給所有
    // 登入者——members 是 array<{uid, instrument, name, account}>（不是純 uid 陣列），沒辦法比照
    // eventRosters 用 hasAny() 限定只回傳自己所屬的名單，這輪先開放整份可讀，曝露程度
    // 比 events/eventTypes 現在對所有人（含訪客）完全公開讀取更低，只是登入者才看得到
    match /concertRosters/{concertId} {
      allow get, list: if hasProfile();
      allow create, update, delete: if isAdminTierFor(concertTeamOf(concertId));
    }

    // Bug 回報／功能許願池：團員只能新增（寫自己 submitterUid），完全不能讀取——
    // 包含提交者本人都看不到，這是使用者明確要求的「單向回報」設計，不像
    // attendanceReports/feePayments 有一條「本人可查詢自己紀錄」的規則，這裡完全
    // 不需要。標記狀態/刪除/內部備註只有 admin-tier 能做，不新增權限旗標——
    // 沒有獨立的「回饋管理」職能角色（9/20 收尾：原本的 isAdminTier() 改成「任一團 admin」）
    match /feedbackItems/{itemId} {
      allow create: if hasProfile() && request.resource.data.submitterUid == request.auth.uid;
      allow get, list: if isAdminTierFor('alumni') || isAdminTierFor('school');
      allow update, delete: if isAdminTierFor('alumni') || isAdminTierFor('school');
    }
  }
}
